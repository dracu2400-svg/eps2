 134:drivers/ds2775g/ds2775g.c ****         return -1;
 135:drivers/ds2775g/ds2775g.c ****     }
 136:drivers/ds2775g/ds2775g.c **** 
 137:drivers/ds2775g/ds2775g.c ****     /* Current gain LSB register configuration */
 138:drivers/ds2775g/ds2775g.c ****     if(ds2775g_write_data(config->onewire_port, config->overcurrent_thresholds_reg, 0x4) == -1)
 139:drivers/ds2775g/ds2775g.c ****     {
 140:drivers/ds2775g/ds2775g.c ****         return -1;
 141:drivers/ds2775g/ds2775g.c ****     }
