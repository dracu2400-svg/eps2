  45:drivers/ds2775g/ds2775g.c **** /**
  46:drivers/ds2775g/ds2775g.c ****  * \brief Configures the DS2775 batteries monitor.
  47:drivers/ds2775g/ds2775g.c ****  *
  48:drivers/ds2775g/ds2775g.c ****  * Configures the DS2775 registers by the following procedure:
  49:drivers/ds2775g/ds2775g.c ****  * - Generates a reset on the one-wire line
  50:drivers/ds2775g/ds2775g.c ****  * - Sends the 0xCC general address to the line (only one slave is present)
  51:drivers/ds2775g/ds2775g.c ****  * - Sends the write command (0x6C)
  52:drivers/ds2775g/ds2775g.c ****  * - Sends the register address
  53:drivers/ds2775g/ds2775g.c ****  * - Sends the value to be written
  54:drivers/ds2775g/ds2775g.c ****  *
  55:drivers/ds2775g/ds2775g.c ****  * The registers are configured as follows:
  56:drivers/ds2775g/ds2775g.c ****  *
  57:drivers/ds2775g/ds2775g.c ****  * <b>Protection Register</b>
  58:drivers/ds2775g/ds2775g.c ****  * Enable charge and discharge.
  59:drivers/ds2775g/ds2775g.c ****  *
  60:drivers/ds2775g/ds2775g.c ****  * <b>Protector Threshold Register</b>
  61:drivers/ds2775g/ds2775g.c ****  * 0x61 bias used to the current accumulation.
  62:drivers/ds2775g/ds2775g.c ****  *
  63:drivers/ds2775g/ds2775g.c ****  * <b>Status Register</b>
  64:drivers/ds2775g/ds2775g.c ****  * Clear all flags.
  65:drivers/ds2775g/ds2775g.c ****  *
  66:drivers/ds2775g/ds2775g.c ****  * <b>Control Register</b>
  67:drivers/ds2775g/ds2775g.c ****  * Set the undervoltage threshold to 2.6 V.
  68:drivers/ds2775g/ds2775g.c ****  *
  69:drivers/ds2775g/ds2775g.c ****  * <b>Overcurrent Threshold Register</b>
  70:drivers/ds2775g/ds2775g.c ****  * Set the short-circuit current to 15 A, the discharge overcurrent
  71:drivers/ds2775g/ds2775g.c ****  * to 7.5 A and the charge overcurrent to 5A.
  72:drivers/ds2775g/ds2775g.c ****  *
  73:drivers/ds2775g/ds2775g.c ****  * <b>Current Gain Register</b>
  74:drivers/ds2775g/ds2775g.c ****  * Removes gain from the measurements.
  75:drivers/ds2775g/ds2775g.c ****  *
  76:drivers/ds2775g/ds2775g.c ****  * If the Write Accumulated Current build is being used, the Accumulated
  77:drivers/ds2775g/ds2775g.c ****  * Current Register is written with 3 Ah.
  78:drivers/ds2775g/ds2775g.c ****  *
  79:drivers/ds2775g/ds2775g.c ****  * In Debug mode, the data sent is read back to verify if it was
  80:drivers/ds2775g/ds2775g.c ****  * configured properly.
  81:drivers/ds2775g/ds2775g.c ****  */
  82:drivers/ds2775g/ds2775g.c **** 
  83:drivers/ds2775g/ds2775g.c **** int ds2775g_init(ds2775g_config_t *config)
  84:drivers/ds2775g/ds2775g.c **** {
  85:drivers/ds2775g/ds2775g.c ****     config->protection_reg[0] = skip_address;
  86:drivers/ds2775g/ds2775g.c ****     config->protection_reg[1] = write_data;
ARM GAS  /tmp/ccFQuQ8c.s 			page 3


  87:drivers/ds2775g/ds2775g.c ****     config->protection_reg[2] = protection_register;
  88:drivers/ds2775g/ds2775g.c ****     config->protection_reg[3] =  0x03;
  89:drivers/ds2775g/ds2775g.c ****     config->protector_threshold_reg[0] = skip_address;
  90:drivers/ds2775g/ds2775g.c ****     config->protector_threshold_reg[1] = write_data;
  91:drivers/ds2775g/ds2775g.c ****     config->protector_threshold_reg[2] = protector_threshold_register;
  92:drivers/ds2775g/ds2775g.c ****     config->protector_threshold_reg[3] = 0x61;
  93:drivers/ds2775g/ds2775g.c ****     config->status_reg[0] = skip_address;
  94:drivers/ds2775g/ds2775g.c ****     config->status_reg[1] = write_data;
  95:drivers/ds2775g/ds2775g.c ****     config->status_reg[2] = status_register;
  96:drivers/ds2775g/ds2775g.c ****     config->status_reg[3] = 0x0;
  97:drivers/ds2775g/ds2775g.c ****     config->control_reg[0] = skip_address;
  98:drivers/ds2775g/ds2775g.c ****     config->control_reg[1] = write_data;
  99:drivers/ds2775g/ds2775g.c ****     config->control_reg[2] = control_register;
 100:drivers/ds2775g/ds2775g.c ****     config->control_reg[3] = 0x0C;
 101:drivers/ds2775g/ds2775g.c ****     config->overcurrent_thresholds_reg[0] = skip_address;
 102:drivers/ds2775g/ds2775g.c ****     config->overcurrent_thresholds_reg[1] = write_data;
 103:drivers/ds2775g/ds2775g.c ****     config->overcurrent_thresholds_reg[2] = overcurrent_thresholds_register;
 104:drivers/ds2775g/ds2775g.c ****     config->overcurrent_thresholds_reg[3] = 0x24;
 105:drivers/ds2775g/ds2775g.c ****     config->current_gain_LSB_reg[0] = skip_address;
 106:drivers/ds2775g/ds2775g.c ****     config->current_gain_LSB_reg[1] = write_data;
 107:drivers/ds2775g/ds2775g.c ****     config->current_gain_LSB_reg[2] = current_gain_LSB_register;
 108:drivers/ds2775g/ds2775g.c ****     config->current_gain_LSB_reg[3] = 0x00;
 109:drivers/ds2775g/ds2775g.c ****     
 110:drivers/ds2775g/ds2775g.c ****     /* Declaring 1-wire pin as P9.1 */
 111:drivers/ds2775g/ds2775g.c ****     config->onewire_port = GPIO_PIN_69;
 112:drivers/ds2775g/ds2775g.c **** 
 113:drivers/ds2775g/ds2775g.c ****     /* Protection register configuration */
 114:drivers/ds2775g/ds2775g.c ****     if(ds2775g_write_data(config->onewire_port, config->protection_reg, 0x4) == -1)
 115:drivers/ds2775g/ds2775g.c ****     {
 116:drivers/ds2775g/ds2775g.c ****         return -1;
 117:drivers/ds2775g/ds2775g.c ****     }
