 227:./core_cm4.h  ****   reg_value &= ~((uint32_t)(0xFFFFUL << 16U) | (uint32_t)(0x07UL << 8U));    /* clear bits to chang
 228:./core_cm4.h  ****   reg_value  =  (reg_value                                   |
 229:./core_cm4.h  ****                 ((uint32_t)0x5FAUL << 16U) |
 230:./core_cm4.h  ****                 (PriorityGroupTmp << 8U)                      );              /* Insert write key a
 231:./core_cm4.h  ****   SCB->AIRCR =  reg_value;
 232:./core_cm4.h  **** }
