 254:system/sys_log/sys_log.c ****         }
 255:system/sys_log/sys_log.c ****         else
 256:system/sys_log/sys_log.c ****         {
 257:system/sys_log/sys_log.c ****             uint8_t uint_str[10];               /* 32-bits = decimal with 10 digits */
ARM GAS  /tmp/ccmsCeBL.s 			page 6


 258:system/sys_log/sys_log.c **** 
 259:system/sys_log/sys_log.c ****             uint8_t digits = log10(uint) + 1;
 260:system/sys_log/sys_log.c **** 
 261:system/sys_log/sys_log.c ****             uint8_t i = 0;
 262:system/sys_log/sys_log.c ****             for(i=0; i<digits; ++i, uint /= 10)
 263:system/sys_log/sys_log.c ****             {
 264:system/sys_log/sys_log.c ****                 uint_str[i] = uint % 10;
 265:system/sys_log/sys_log.c ****             }
 266:system/sys_log/sys_log.c **** 
 267:system/sys_log/sys_log.c ****             uint8_t j = 0;
 268:system/sys_log/sys_log.c ****             for(j=i; j>0; j--)
 269:system/sys_log/sys_log.c ****             {
 270:system/sys_log/sys_log.c ****                 sys_log_print_digit(uint_str[j-1]);
 271:system/sys_log/sys_log.c ****             }
 272:system/sys_log/sys_log.c ****         }
 273:system/sys_log/sys_log.c ****     }
 274:system/sys_log/sys_log.c **** }
