 336:system/sys_log/sys_log.c **** void sys_log_print_float(float flt, uint8_t digits)
 337:system/sys_log/sys_log.c **** {
 338:system/sys_log/sys_log.c ****     if (sys_log_current_level >= CONFIG_GLOBAL_LOG_LEVEL)
 339:system/sys_log/sys_log.c ****     {
 340:system/sys_log/sys_log.c ****         if (flt < 0)
 341:system/sys_log/sys_log.c ****         {
 342:system/sys_log/sys_log.c ****             sys_log_print_msg("-");
 343:system/sys_log/sys_log.c **** 
 344:system/sys_log/sys_log.c ****             flt = abs(flt);
 345:system/sys_log/sys_log.c ****         }
 346:system/sys_log/sys_log.c **** 
 347:system/sys_log/sys_log.c ****         /* Extract integer part */
 348:system/sys_log/sys_log.c ****         uint32_t ipart = (uint32_t)flt;
 349:system/sys_log/sys_log.c **** 
 350:system/sys_log/sys_log.c ****         /* Extract floating part */
 351:system/sys_log/sys_log.c ****         float fpart = flt - (float)ipart;
 352:system/sys_log/sys_log.c **** 
 353:system/sys_log/sys_log.c ****         /* Print integer part */
 354:system/sys_log/sys_log.c ****         sys_log_print_uint(ipart);
 355:system/sys_log/sys_log.c **** 
 356:system/sys_log/sys_log.c ****         /* Print decimal point */
 357:system/sys_log/sys_log.c ****         sys_log_print_msg(".");
 358:system/sys_log/sys_log.c **** 
 359:system/sys_log/sys_log.c ****         /* Print floating part */
 360:system/sys_log/sys_log.c ****         sys_log_print_uint((uint32_t)(fpart*pow(10, digits)));
 361:system/sys_log/sys_log.c ****     }
 362:system/sys_log/sys_log.c **** }
