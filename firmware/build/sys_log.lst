 215:system/sys_log/sys_log.c **** void sys_log_print_digit(uint8_t digit)
 216:system/sys_log/sys_log.c **** {
 217:system/sys_log/sys_log.c ****     if (sys_log_current_level >= CONFIG_GLOBAL_LOG_LEVEL)
 218:system/sys_log/sys_log.c ****     {
 219:system/sys_log/sys_log.c ****         if (digit < 0x0A)
 220:system/sys_log/sys_log.c ****         {
 221:system/sys_log/sys_log.c ****             sys_log_print_byte(digit + 0x30);    /* 0x30 = ascii 0 */
 222:system/sys_log/sys_log.c ****         }
 223:system/sys_log/sys_log.c ****         else if (digit <= 0x0F)
 224:system/sys_log/sys_log.c ****         {
 225:system/sys_log/sys_log.c ****             sys_log_print_byte(digit + 0x37);    /* 0x37 = ascii 7 */
 226:system/sys_log/sys_log.c ****         }
 227:system/sys_log/sys_log.c ****         else
 228:system/sys_log/sys_log.c ****         {
 229:system/sys_log/sys_log.c ****             sys_log_print_byte('N');
 230:system/sys_log/sys_log.c ****         }
 231:system/sys_log/sys_log.c ****     }
 232:system/sys_log/sys_log.c **** }
