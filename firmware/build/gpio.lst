  51:drivers/gpio/gpio.c **** /**
  52:drivers/gpio/gpio.c ****  * \brief GPIO pin mapping table (GPIO_PIN_x → STM32 port/pin).
  53:drivers/gpio/gpio.c ****  *
  54:drivers/gpio/gpio.c ****  * Based on STM32_PIN_MAPPING.md:
  55:drivers/gpio/gpio.c ****  * - GPIO_PIN_0-7:   PA0-PA7
  56:drivers/gpio/gpio.c ****  * - GPIO_PIN_8-15:  PB0-PB7
  57:drivers/gpio/gpio.c ****  * - GPIO_PIN_16-23: PC0-PC7
  58:drivers/gpio/gpio.c ****  * - GPIO_PIN_24-31: PA8-PA15
  59:drivers/gpio/gpio.c ****  * - GPIO_PIN_32+:   Not mapped (reserved for future expansion)
  60:drivers/gpio/gpio.c ****  */
  61:drivers/gpio/gpio.c **** static const stm32_pin_t pin_map[] = {
  62:drivers/gpio/gpio.c ****     [GPIO_PIN_0]  = {GPIOA, 0},   /* PA0  - LED_STATUS */
  63:drivers/gpio/gpio.c ****     [GPIO_PIN_1]  = {GPIOA, 1},   /* PA1  - UART_TX2 */
  64:drivers/gpio/gpio.c ****     [GPIO_PIN_2]  = {GPIOA, 2},   /* PA2  - UART_RX2 */
  65:drivers/gpio/gpio.c ****     [GPIO_PIN_3]  = {GPIOA, 3},   /* PA3  - ADC_IN3 */
  66:drivers/gpio/gpio.c ****     [GPIO_PIN_4]  = {GPIOA, 4},   /* PA4  - SPI1_NSS */
  67:drivers/gpio/gpio.c ****     [GPIO_PIN_5]  = {GPIOA, 5},   /* PA5  - SPI1_SCK */
  68:drivers/gpio/gpio.c ****     [GPIO_PIN_6]  = {GPIOA, 6},   /* PA6  - SPI1_MISO */
  69:drivers/gpio/gpio.c ****     [GPIO_PIN_7]  = {GPIOA, 7},   /* PA7  - SPI1_MOSI */
  70:drivers/gpio/gpio.c ****     [GPIO_PIN_8]  = {GPIOB, 0},   /* PB0  - ADC_IN15 */
  71:drivers/gpio/gpio.c ****     [GPIO_PIN_9]  = {GPIOB, 1},   /* PB1  - ADC_IN16 */
  72:drivers/gpio/gpio.c ****     [GPIO_PIN_10] = {GPIOB, 2},   /* PB2  - GPIO */
  73:drivers/gpio/gpio.c ****     [GPIO_PIN_11] = {GPIOB, 3},   /* PB3  - SPI2_NSS */
  74:drivers/gpio/gpio.c ****     [GPIO_PIN_12] = {GPIOB, 4},   /* PB4  - SPI2_MISO */
  75:drivers/gpio/gpio.c ****     [GPIO_PIN_13] = {GPIOB, 5},   /* PB5  - SPI2_MOSI */
  76:drivers/gpio/gpio.c ****     [GPIO_PIN_14] = {GPIOB, 6},   /* PB6  - UART_TX1 */
  77:drivers/gpio/gpio.c ****     [GPIO_PIN_15] = {GPIOB, 7},   /* PB7  - UART_RX1 */
  78:drivers/gpio/gpio.c ****     [GPIO_PIN_16] = {GPIOB, 8},   /* PB8  - I2C1_SCL */
  79:drivers/gpio/gpio.c ****     [GPIO_PIN_17] = {GPIOB, 9},   /* PB9  - I2C1_SDA */
  80:drivers/gpio/gpio.c ****     [GPIO_PIN_18] = {GPIOB, 10},  /* PB10 - UART_TX3 */
  81:drivers/gpio/gpio.c ****     [GPIO_PIN_19] = {GPIOB, 11},  /* PB11 - UART_RX3 */
  82:drivers/gpio/gpio.c ****     [GPIO_PIN_20] = {GPIOB, 12},  /* PB12 - SPI2_NSS_ALT */
  83:drivers/gpio/gpio.c ****     [GPIO_PIN_21] = {GPIOB, 13},  /* PB13 - SPI2_SCK */
  84:drivers/gpio/gpio.c ****     [GPIO_PIN_22] = {GPIOB, 14},  /* PB14 - GPIO */
  85:drivers/gpio/gpio.c ****     [GPIO_PIN_23] = {GPIOB, 15},  /* PB15 - GPIO */
  86:drivers/gpio/gpio.c ****     [GPIO_PIN_24] = {GPIOC, 0},   /* PC0  - ADC_IN1 */
  87:drivers/gpio/gpio.c ****     [GPIO_PIN_25] = {GPIOC, 1},   /* PC1  - ADC_IN2 */
