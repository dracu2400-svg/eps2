  46:system/clocks.c ****     /* Note: For STM32L4, the clock configuration is done in SystemClock_Config()
  47:system/clocks.c ****      * which is called from main(). This function is kept for API compatibility
  48:system/clocks.c ****      * but the actual configuration is hardcoded to 80 MHz from PLL.
  49:system/clocks.c ****      *
  50:system/clocks.c ****      * Clock tree for STM32L476RG:
  51:system/clocks.c ****      * - MSI 4 MHz → PLL (×40 ÷ 2) → 80 MHz SYSCLK
  52:system/clocks.c ****      * - HCLK  = SYSCLK = 80 MHz (AHB)
  53:system/clocks.c ****      * - PCLK1 = HCLK/1 = 80 MHz (APB1)
  54:system/clocks.c ****      * - PCLK2 = HCLK/1 = 80 MHz (APB2)
  55:system/clocks.c ****      */
  56:system/clocks.c **** 
  57:system/clocks.c ****     /* Configure system clock to 80 MHz */
  58:system/clocks.c ****     SystemClock_Config();
