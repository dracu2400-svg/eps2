  74:system_stm32l4xx.c **** #define RCC_PLLCFGR_PLLM_DIV1   (0x0UL << 4)  /* PLLM = 1 */
  75:system_stm32l4xx.c **** #define RCC_PLLCFGR_PLLN_MUL40  (40UL << 8)   /* PLLN = 40 */
  76:system_stm32l4xx.c **** #define RCC_PLLCFGR_PLLR_DIV2   (0x0UL << 25) /* PLLR = 2 */
  77:system_stm32l4xx.c **** #define RCC_PLLCFGR_PLLREN      (1UL << 24)   /* Enable PLLR output */
  78:system_stm32l4xx.c **** 
