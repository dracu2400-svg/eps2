  49:system_stm32l4xx.c **** #define RCC_CR_HSERDY         (1UL << 17)
  50:system_stm32l4xx.c **** #define RCC_CR_PLLON          (1UL << 24)
  51:system_stm32l4xx.c **** #define RCC_CR_PLLRDY         (1UL << 25)
  52:system_stm32l4xx.c **** 
  53:system_stm32l4xx.c **** /* RCC_CFGR bits */
  54:system_stm32l4xx.c **** #define RCC_CFGR_SW_MSI       (0x0UL << 0)
  55:system_stm32l4xx.c **** #define RCC_CFGR_SW_HSI       (0x1UL << 0)
  56:system_stm32l4xx.c **** #define RCC_CFGR_SW_HSE       (0x2UL << 0)
  57:system_stm32l4xx.c **** #define RCC_CFGR_SW_PLL       (0x3UL << 0)
