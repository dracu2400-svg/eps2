  59:system_stm32l4xx.c **** #define RCC_CFGR_SWS_HSI      (0x1UL << 2)
  60:system_stm32l4xx.c **** #define RCC_CFGR_SWS_HSE      (0x2UL << 2)
  61:system_stm32l4xx.c **** #define RCC_CFGR_SWS_PLL      (0x3UL << 2)
  62:system_stm32l4xx.c **** 
  63:system_stm32l4xx.c **** /* FLASH_ACR bits */
  64:system_stm32l4xx.c **** #define FLASH_ACR_LATENCY_4WS (4UL << 0)
  65:system_stm32l4xx.c **** #define FLASH_ACR_PRFTEN      (1UL << 8)
  66:system_stm32l4xx.c **** #define FLASH_ACR_ICEN        (1UL << 9)
  67:system_stm32l4xx.c **** #define FLASH_ACR_DCEN        (1UL << 10)
  68:system_stm32l4xx.c **** 
